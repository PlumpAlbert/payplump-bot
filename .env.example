# Copy to .env for Compose and fill in values locally; never commit .env.
# The application reads process environment; it does not load .env itself.
# Required target when DATABASE_URL is not set:
PGHOST=
PGUSER=
PGDATABASE=
# Set all PG* fields for CI. Compose also requires PGSSLMODE and PGPASSWORD.
PGPORT=
PGSSLMODE=
PGPASSWORD=
# Optional alternative for the application (PG* fields are used otherwise):
# DATABASE_URL=
DB_MAX_CONNS=4
HTTP_ADDR=127.0.0.1:8080
# Calendar dates use the process timezone; set explicitly in containers.
TZ=UTC
HEALTHCHECK_URL=http://127.0.0.1:8080/readyz
# Incoming Telegram webhooks are opt-in. Use a separate test bot for development.
TELEGRAM_ENABLED=false
# Required only when TELEGRAM_ENABLED=true; supply the token securely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Public HTTPS URL with path /telegram/webhook; no userinfo, query or fragment.
TELEGRAM_WEBHOOK_URL=
# Separate random runtime secret, also sent to Telegram as secret_token.
TELEGRAM_WEBHOOK_SECRET=
# Durable delivery starts only when Telegram is enabled and setup succeeds.
OUTBOX_WORKERS=2
OUTBOX_POLL_INTERVAL=1s

# Admin broadcast is default-off. Stage 10 requires Telegram administrator IDs.
# Increase the explicit revision after any authorization/policy change; never reset it.
BROADCAST_ENABLED=false
BROADCAST_POLICY_REVISION=
BROADCAST_MAX_RECIPIENTS=1000
BROADCAST_BATCH_SIZE=50
BROADCAST_WORKERS=1
BROADCAST_POLL_INTERVAL=1s

# First-invoice writes are separately opt-in. Read docs/registration.md FIRST.
# Leave disabled until an explicitly approved test record verifies live writes.
REGISTRATION_ENABLED=false
REGISTRATION_WORKERS=1
REGISTRATION_POLL_INTERVAL=1s
REGISTRATION_HTTP_TIMEOUT=5s
# Explicitly excluded nonbilling users: exact positive Telegram IDs, comma-separated.
# Confirm these privately before enabling writes; never put real IDs in Git.
REGISTRATION_EXCLUDED_TELEGRAM_IDS=

# Payment verification is independently opt-in and GET-only. Read docs/payments.md.
# It records proof/dates, but never grants access or creates recurring invoices.
PAYMENTS_ENABLED=false
PAYMENTS_WORKERS=1
PAYMENTS_POLL_INTERVAL=1s
PAYMENTS_RECHECK_INTERVAL=5m
PAYMENTS_HTTP_TIMEOUT=5s
# Required explicit Invoice Ninja currency ID (not RUB/USD or ISO numeric code).
# Confirm the company's native currency first; FX/group-default cases are held.
PAYMENTS_CURRENCY_ID=

# Sent-invoice lifecycle detection is independently DEFAULT-OFF and GET-only.
# Read docs/invoice-lifecycle.md before enabling. This stage sends Telegram notices
# and hands off to payment verification; it does not pause recurring or change access.
INVOICE_LIFECYCLE_ENABLED=false
INVOICE_LIFECYCLE_WEBHOOK_SECRET=
# Required private allowlist (1-20 canonical Telegram IDs); exclusions win.
# Never commit real IDs. Use the event-specific sent_invoice webhook route only.
INVOICE_LIFECYCLE_ALLOWED_TELEGRAM_IDS=
INVOICE_LIFECYCLE_WORKERS=1
INVOICE_LIFECYCLE_POLL_INTERVAL=1s
INVOICE_LIFECYCLE_RECHECK_INTERVAL=5m
INVOICE_LIFECYCLE_HTTP_TIMEOUT=5s
INVOICE_LIFECYCLE_MAX_ACCOUNTS=1000

# Overdue enforcement is a separate DEFAULT-OFF Stage 2 writer. Read
# docs/invoice-lifecycle.md FIRST. It requires Stage 1, payments, the same pilot
# allowlist, and explicit exclusive-writer acknowledgement. Unknown write outcomes
# pin the shared writer guard for manual review; this does not restore paid access.
INVOICE_OVERDUE_ENFORCEMENT_ENABLED=false
INVOICE_OVERDUE_EXCLUSIVE_WRITER=false
INVOICE_OVERDUE_WORKERS=1
INVOICE_OVERDUE_POLL_INTERVAL=1s
INVOICE_OVERDUE_HTTP_TIMEOUT=5s
INVOICE_OVERDUE_MAX_ACCOUNTS=1000

# Paid renewal/reactivation is a separate DEFAULT-OFF Stage 9a writer. Read
# docs/invoice-lifecycle.md FIRST. Requires Stage 1, Telegram, payments, the same
# pilot allowlist, exclusions, and exclusive-writer acknowledgement. It does not
# deliver protected configuration; that is a separate later stage.
INVOICE_RENEWAL_ENABLED=false
INVOICE_RENEWAL_EXCLUSIVE_WRITER=false
INVOICE_RENEWAL_WORKERS=1
INVOICE_RENEWAL_POLL_INTERVAL=1s
INVOICE_RENEWAL_HTTP_TIMEOUT=5s
INVOICE_RENEWAL_MAX_ACCOUNTS=1000

# First activation is a separate DEFAULT-OFF pilot. Read docs/activation.md FIRST.
# Requires Telegram + payments, explicit SUI_VERSION, native currency/tax policy.
# No production rollout before overdue enforcement and approved live tests.
ACTIVATION_ENABLED=false
# Acknowledge that other apps/admin UI/automation will NOT write concurrently.
ACTIVATION_EXCLUSIVE_WRITER=false
# Required private pilot allowlist (1-20 canonical Telegram IDs); excluded IDs win.
# NEVER commit real IDs. Delivery uses this same list but a separate opt-in.
ACTIVATION_ALLOWED_TELEGRAM_IDS=
ACTIVATION_WORKERS=1
ACTIVATION_POLL_INTERVAL=1s
ACTIVATION_HTTP_TIMEOUT=5s
ACTIVATION_MAX_SUI_ACCOUNTS=1000

# Protected, on-demand FIRST-CYCLE delivery only. Read docs/configuration-delivery.md.
# No automatic retries after a protected send; an unknown result pins its chat.
CONFIGURATION_DELIVERY_ENABLED=false
# Required explicit positive revision when enabled; increase after policy changes
# or a disabled startup. Read persisted revision before re-enabling. Never reset it.
CONFIGURATION_POLICY_REVISION=
CONFIGURATION_HTTP_TIMEOUT=3s

# Integrations are read-only through `payplump check-integrations`, even if the
# registration feature is enabled. Client menu GETs run only on an explicit
# invoice request, independently of registration. Startup does not probe APIs.
# Version fields are optional; enabled webhooks use separate event-specific routes and secrets.
# Use separate test environments or clearly identified test records.
# Keep tokens and other real values in .env, never in this example or Git.

# Invoice Ninja: service base URL, without /api/v1, query strings or credentials.
INVOICE_NINJA_BASE_URL=
INVOICE_NINJA_API_TOKEN=
# Installed version, copied from the service UI; not an API version such as v5.
INVOICE_NINJA_VERSION=
# Product ID returned by the API; price will be read from Invoice Ninja.
INVOICE_NINJA_PRODUCT_ID=
# Required choice for registration/activation: true/false matching pricing.
# Empty is intentional: do not guess whether product prices include tax.
INVOICE_NINJA_INCLUSIVE_TAXES=
# Source of Telegram IDs: id_number if reserved for this purpose, or custom_value1-4.
# Do not use the internal id or the display number. Existing data is never rewritten.
INVOICE_NINJA_TELEGRAM_ID_FIELD=id_number
# Separate 32-256 character ASCII [A-Za-z0-9_-] secret for the optional receiver.
# Configure X-Payplump-Webhook-Secret manually in Invoice Ninja webhook headers.
# This is NOT an HMAC signature; never reuse API or Telegram credentials.
INVOICE_NINJA_WEBHOOK_SECRET=

# S-UI: panel base URL, including its custom path if configured; no API suffix.
SUI_BASE_URL=
SUI_API_TOKEN=
# Optional for preflight; REQUIRED as 1.6.4 (or exact v-prefixed claim) for activation,
# overdue enforcement, and protected delivery.
# Writes separately GET-check status/sys; version claims are not build attestation.
SUI_VERSION=
# Comma-separated inbound IDs selected for the subscription.
SUI_INBOUND_IDS=
# Public subscription service base URL, without client-specific IDs, keys or query.
# Protected delivery requires HTTPS here; private NetBird SUI_BASE_URL may use HTTP.
SUI_SUBSCRIPTION_BASE_URL=

# Request timeout and finite pagination bounds for the read-only command.
INTEGRATION_HTTP_TIMEOUT=10s
INTEGRATION_PAGE_SIZE=50
INTEGRATION_MAX_PAGES=20

# Private 11a.3 read-only verification CLI policy. This is independent of all
# runtime feature flags and never enables startup workers or Telegram access.
# Set pilot IDs only through the operator's private environment; examples stay blank.
IMPORT_VERIFY_BOT_ID=
IMPORT_VERIFY_ALLOWED_TELEGRAM_IDS=
IMPORT_VERIFY_EXCLUDED_TELEGRAM_IDS=
# Explicit owner acknowledgement mapping the native Invoice Ninja currency ID to ISO code.
IMPORT_VERIFY_CURRENCY_CODE=
# Explicit legacy product key; the verifier freezes source price/template, not current catalog price.
IMPORT_VERIFY_PRODUCT_KEY=
IMPORT_VERIFY_MAX_RECORDS=20
IMPORT_VERIFY_MAX_INVENTORY_RECORDS=1000
IMPORT_VERIFY_MAX_HISTORICAL_ANCHORS=10
IMPORT_VERIFY_EVIDENCE_TTL=5m

# Imported READ runtime is independently default-off; it requires Telegram,
# payments, and the strict IMPORT_VERIFY policy above. Runtime admission is a
# separate explicit permission from import-apply CLI admission; these flags do
# not grant it.
IMPORTED_RUNTIME_ENABLED=false
# Required canonical positive revision only when IMPORTED_RUNTIME_ENABLED=true.
IMPORTED_RUNTIME_REVISION=
# Imported effects are a separate explicit durable grant, never implied by
# READ runtime admission. Requires IMPORTED_RUNTIME_ENABLED=true and its own
# revision, verified bot, and source policy. Unknown/incomplete imported
# records remain blocked; disabling effects does not re-arm or authorize them.
IMPORTED_EFFECTS_ENABLED=false
# Required canonical positive revision only when effects are explicitly enabled.
IMPORTED_EFFECTS_REVISION=

# Required phone for registration invoice messages; optional for client-menu
# requests (without it the bot asks the user to contact the administrator).
# Ignored by the read-only check-integrations command.
PAYMENT_PHONE=
# Optional bank and recipient display name, if required for the transfer.
PAYMENT_BANK=
PAYMENT_RECIPIENT=
