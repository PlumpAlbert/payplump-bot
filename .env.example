# Copy to .env for Compose and fill in values locally; never commit .env.
# The application reads process environment; it does not load .env itself.
# Required target when DATABASE_URL is not set:
PGHOST=
PGUSER=
PGDATABASE=
# Set all PG* fields for CI. Compose also requires PGSSLMODE and PGPASSWORD.
PGPORT=
PGSSLMODE=
PGPASSWORD=
# Optional alternative for the application (PG* fields are used otherwise):
# DATABASE_URL=
DB_MAX_CONNS=4
HTTP_ADDR=127.0.0.1:8080
# Calendar dates use the process timezone; set explicitly in containers.
TZ=UTC
HEALTHCHECK_URL=http://127.0.0.1:8080/readyz
# Incoming Telegram webhooks are opt-in. Use a separate test bot for development.
TELEGRAM_ENABLED=false
# Required only when TELEGRAM_ENABLED=true; supply the token securely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Public HTTPS URL with path /telegram/webhook; no userinfo, query or fragment.
TELEGRAM_WEBHOOK_URL=
# Separate random runtime secret, also sent to Telegram as secret_token.
TELEGRAM_WEBHOOK_SECRET=
# Durable delivery starts only when Telegram is enabled and setup succeeds.
OUTBOX_WORKERS=2
OUTBOX_POLL_INTERVAL=1s

# First-invoice writes are separately opt-in. Read docs/registration.md FIRST.
# Leave disabled until an explicitly approved test record verifies live writes.
REGISTRATION_ENABLED=false
REGISTRATION_WORKERS=1
REGISTRATION_POLL_INTERVAL=1s
REGISTRATION_HTTP_TIMEOUT=5s
# Explicitly excluded nonbilling users: exact positive Telegram IDs, comma-separated.
# Confirm these privately before enabling writes; never put real IDs in Git.
REGISTRATION_EXCLUDED_TELEGRAM_IDS=

# Payment verification is independently opt-in and GET-only. Read docs/payments.md.
# It records proof/dates, but never grants access or creates recurring invoices.
PAYMENTS_ENABLED=false
PAYMENTS_WORKERS=1
PAYMENTS_POLL_INTERVAL=1s
PAYMENTS_RECHECK_INTERVAL=5m
PAYMENTS_HTTP_TIMEOUT=5s
# Required explicit Invoice Ninja currency ID (not RUB/USD or ISO numeric code).
# Confirm the company's native currency first; FX/group-default cases are held.
PAYMENTS_CURRENCY_ID=

# Integrations are read-only through `payplump check-integrations`, even if the
# registration feature is enabled. Client menu GETs run only on an explicit
# invoice request, independently of registration. Startup does not probe APIs.
# Version fields are optional; incoming payment webhooks are for later steps.
# Use separate test environments or clearly identified test records.
# Keep tokens and other real values in .env, never in this example or Git.

# Invoice Ninja: service base URL, without /api/v1, query strings or credentials.
INVOICE_NINJA_BASE_URL=
INVOICE_NINJA_API_TOKEN=
# Installed version, copied from the service UI; not an API version such as v5.
INVOICE_NINJA_VERSION=
# Product ID returned by the API; price will be read from Invoice Ninja.
INVOICE_NINJA_PRODUCT_ID=
# Required choice for registration: true/false matching the pricing convention.
# Empty is intentional: do not guess whether product prices include tax.
INVOICE_NINJA_INCLUSIVE_TAXES=
# Source of Telegram IDs: id_number if reserved for this purpose, or custom_value1-4.
# Do not use the internal id or the display number. Existing data is never rewritten.
INVOICE_NINJA_TELEGRAM_ID_FIELD=id_number
# Separate 32-256 character ASCII [A-Za-z0-9_-] secret for the optional receiver.
# Configure X-Payplump-Webhook-Secret manually in Invoice Ninja webhook headers.
# This is NOT an HMAC signature; never reuse API or Telegram credentials.
INVOICE_NINJA_WEBHOOK_SECRET=

# S-UI: panel base URL, including its custom path if configured; no API suffix.
SUI_BASE_URL=
SUI_API_TOKEN=
# Optional installed version copied from the panel UI; declaration, not API verification.
SUI_VERSION=
# Comma-separated inbound IDs selected for the subscription.
SUI_INBOUND_IDS=
# Public subscription service base URL, without client-specific IDs, keys or query.
SUI_SUBSCRIPTION_BASE_URL=

# Request timeout and finite pagination bounds for the read-only command.
INTEGRATION_HTTP_TIMEOUT=10s
INTEGRATION_PAGE_SIZE=50
INTEGRATION_MAX_PAGES=20

# Required phone for registration invoice messages; optional for client-menu
# requests (without it the bot asks the user to contact the administrator).
# Ignored by the read-only check-integrations command.
PAYMENT_PHONE=
# Optional bank and recipient display name, if required for the transfer.
PAYMENT_BANK=
PAYMENT_RECIPIENT=
