# Copy to a private runtime env file; never commit real values. The Go process
# reads its process environment; it does not load .env itself.
# Required database settings: DATABASE_URL OR PGHOST/PGUSER/PGDATABASE.
# Полная строка подключения к PostgreSQL; альтернатива отдельным параметрам PG*.
DATABASE_URL=
# Адрес сервера PostgreSQL при подключении через PG*.
PGHOST=
# Порт PostgreSQL; обычно 5432.
PGPORT=5432
# Имя пользователя PostgreSQL.
PGUSER=
# Имя отдельной базы данных бота.
PGDATABASE=
# Режим TLS к PostgreSQL; verify-full проверяет сертификат и имя сервера.
PGSSLMODE=verify-full
# Пароль пользователя PostgreSQL при подключении через PG*.
PGPASSWORD=
# Максимальное число соединений бота с БД; по умолчанию 4.
DB_MAX_CONNS=4
# Адрес и порт HTTP-сервера бота для webhook и проверок состояния.
HTTP_ADDR=127.0.0.1:8080
# Расчётный часовой пояс для счетов и продлений: например UTC или Europe/Moscow.
TZ=UTC

# Telegram: long polling по умолчанию, webhook — если задан его URL.
# Токен Telegram-бота, выданный BotFather.
TELEGRAM_BOT_TOKEN=
# Числовые Telegram ID администраторов через запятую; не @username.
TELEGRAM_ADMIN_IDS=
# Необязательный HTTPS URL с путём /telegram/webhook; пусто — long polling.
TELEGRAM_WEBHOOK_URL=
# Секрет только для webhook: 1–256 символов A-Z, a-z, 0-9, _ и -.
TELEGRAM_WEBHOOK_SECRET=

# Invoice Ninja business configuration.
# Базовый адрес Invoice Ninja без суффикса /api/v1.
INVOICE_NINJA_BASE_URL=
# API-токен Invoice Ninja для работы с клиентами, счетами и оплатами.
INVOICE_NINJA_API_TOKEN=
# Ожидаемая версия Ninja: поддерживается 5.13.47; можно оставить пустой.
INVOICE_NINJA_VERSION=
# API ID продукта с месячным тарифом в Ninja; не название продукта.
INVOICE_NINJA_PRODUCT_ID=
# Включены ли налоги в цену продукта: явно true или false, как настроено в Ninja.
INVOICE_NINJA_INCLUSIVE_TAXES=
# Поле клиента Ninja для Telegram ID; текущая запись поддерживает только id_number.
INVOICE_NINJA_TELEGRAM_ID_FIELD=id_number
# ВНИМАНИЕ: это секреты бота, не встроенные секреты/подписи Invoice Ninja.
# Бот требует X-Payplump-Webhook-Secret; доставка и проверка отправителя ещё
# не настроены и не проверены. Нельзя добавлять заголовок всем запросам подряд.
# Оба секрета обязательны для запуска; см. alert в docs/configuration.md.
# Секрет проверки webhook Ninja об оплате счетов (32–256 символов A-Z, a-z, 0-9, _ или -).
INVOICE_NINJA_WEBHOOK_SECRET=
# Другой секрет для последующих счетов (те же ограничения, не повторять первый).
INVOICE_LIFECYCLE_WEBHOOK_SECRET=

# S-UI business configuration.
# Базовый адрес панели S-UI без суффикса /apiv2.
SUI_BASE_URL=
# API-токен S-UI для управления доступом клиентов.
SUI_API_TOKEN=
# Версия S-UI; поддерживается 1.6.4.
SUI_VERSION=1.6.4
# Числовые ID разрешённых inbounds (точек подключения) S-UI через запятую.
SUI_INBOUND_IDS=
# Публичная HTTPS-база для ссылок на подписки, доступная клиентам.
SUI_SUBSCRIPTION_BASE_URL=https://subscription.example.invalid

# Shared native payment currency (Invoice Ninja currency ID plus ISO 4217 code).
# Внутренний ID валюты в Ninja; должен соответствовать валюте продукта и счетов.
PAYMENTS_CURRENCY_ID=
# Трёхбуквенный ISO-код той же валюты, например RUB или USD.
PAYMENTS_CURRENCY_CODE=
# Номер телефона для оплаты, который бот показывает клиентам.
PAYMENT_PHONE=
# Название банка для оплаты; необязательно.
PAYMENT_BANK=
# Имя получателя платежа; необязательно.
PAYMENT_RECIPIENT=
# Необязательные Telegram ID для запрета регистрации и импорта, через запятую.
REGISTRATION_EXCLUDED_TELEGRAM_IDS=

# Advanced internal tuning is optional; see docs/configuration.md.
# HTTP_ADDR and DB_MAX_CONNS have code defaults when omitted.
# TZ is an explicit calendar business setting, including when UTC is intended.
