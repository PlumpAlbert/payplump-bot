# Copy to .env for Compose and fill in values locally; never commit .env.
# The application reads process environment; it does not load .env itself.
# Required target when DATABASE_URL is not set:
PGHOST=
PGUSER=
PGDATABASE=
# Set all PG* fields for CI. Compose also requires PGSSLMODE and PGPASSWORD.
PGPORT=
PGSSLMODE=
PGPASSWORD=
# Optional alternative for the application (PG* fields are used otherwise):
# DATABASE_URL=
DB_MAX_CONNS=4
HTTP_ADDR=127.0.0.1:8080
HEALTHCHECK_URL=http://127.0.0.1:8080/readyz
# Incoming Telegram webhooks are opt-in. Use a separate test bot for development.
TELEGRAM_ENABLED=false
# Required only when TELEGRAM_ENABLED=true; supply the token securely.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
# Public HTTPS URL with path /telegram/webhook; no userinfo, query or fragment.
TELEGRAM_WEBHOOK_URL=
# Separate random runtime secret, also sent to Telegram as secret_token.
TELEGRAM_WEBHOOK_SECRET=
