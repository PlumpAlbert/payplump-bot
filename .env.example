# Copy to a private runtime env file; never commit real values. The Go process
# reads its process environment; it does not load .env itself.
# Required database settings: DATABASE_URL OR PGHOST/PGUSER/PGDATABASE.
DATABASE_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGDATABASE=
PGSSLMODE=verify-full
PGPASSWORD=
DB_MAX_CONNS=4
HTTP_ADDR=127.0.0.1:8080
TZ=UTC

# Telegram and public webhook (required for normal service).
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_URL=https://bot.example.invalid/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=

# Invoice Ninja business configuration.
INVOICE_NINJA_BASE_URL=
INVOICE_NINJA_API_TOKEN=
INVOICE_NINJA_VERSION=
INVOICE_NINJA_PRODUCT_ID=
INVOICE_NINJA_INCLUSIVE_TAXES=
INVOICE_NINJA_TELEGRAM_ID_FIELD=id_number
INVOICE_NINJA_WEBHOOK_SECRET=
INVOICE_LIFECYCLE_WEBHOOK_SECRET=

# S-UI business configuration.
SUI_BASE_URL=
SUI_API_TOKEN=
SUI_VERSION=1.6.4
SUI_INBOUND_IDS=
SUI_SUBSCRIPTION_BASE_URL=https://subscription.example.invalid

# Shared native payment currency (Invoice Ninja currency ID plus ISO 4217 code).
PAYMENTS_CURRENCY_ID=
PAYMENTS_CURRENCY_CODE=
PAYMENT_PHONE=
PAYMENT_BANK=
PAYMENT_RECIPIENT=
# Optional: canonical Telegram IDs intentionally excluded from billing.
REGISTRATION_EXCLUDED_TELEGRAM_IDS=

# Advanced internal tuning is optional; see docs/configuration.md.
# HTTP_ADDR and DB_MAX_CONNS have code defaults when omitted.
# TZ is an explicit calendar business setting, including when UTC is intended.
